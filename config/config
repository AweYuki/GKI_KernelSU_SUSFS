# ==================== Custom Commit Configuration ====================
# Configures custom commit hashes for the SUSFS and AweYukiSU repositories.
#
# Usage:
#   1. Set custom=true to enable custom commits
#   2. Fill in the desired commit hash after the corresponding key
#   3. Leave blank to use the latest commit on that branch
#
# Example:
#   gki-android14-6.1=abc123def456
#   aweyukisu=def789abc123
#
# =====================================================================

# Enable custom commits (true/false)
custom=false

# ==================== SUSFS branch commit hashes ====================
# Effective only when custom=true
gki-android12-5.10=
gki-android13-5.15=
gki-android14-6.1=
gki-android15-6.6=
gki-android16-6.12=

# ==================== AweYukiSU commit hash ====================
# Effective only when custom=true
aweyukisu=
